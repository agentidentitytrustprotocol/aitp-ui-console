# Local development. The hosted console's values live in Doppler project
# aitp-ui-console (prd -> Vercel Production via deploy/doppler-sync.sh; dev
# mirrors this file's localhost URLs). See internal_docs/DEPLOYMENT.md.

# Playground (Python FastAPI)
PLAYGROUND_URL=http://localhost:8000
PLAYGROUND_API_KEY=

# Control Plane (Next.js)
CP_URL=http://localhost:4000
CP_API_KEY=
# The CP's read-only key, used for read-class CP routes. Unset: those routes
# fall back to CP_API_KEY while public mode is off (and log it); with public
# mode on, anonymous CP reads return 503 without it.
CP_READ_API_KEY=

# Public mode: on/true/1 lets anonymous visitors use the read routes and launch
# runs under per-IP limits; admin routes still need the operator. Anything else
# (the default) is off: every route needs the operator.
AITP_CONSOLE_PUBLIC_MODE=off

# Off Vercel only: the request header holding the real client IP, set by your
# reverse proxy (e.g. x-real-ip). Unset, every caller shares one rate-limit
# bucket. On Vercel the platform headers are used and this is ignored.
# CONSOLE_CLIENT_IP_HEADER=x-real-ip

# Local stack only: admit a CP manifest whose handshake_endpoint is
# http://localhost or http://127.0.0.1. Without it such a manifest reads
# NOT VERIFIED (malformed). Other hosts are refused either way, and a production
# build ignores this. Never set it on a deployed environment.
# AITP_INSECURE_LOCALHOST_DANGEROUS=1

# Operator login (required). Until both are set every route returns 503.
# CONSOLE_PASSWORD: 24+ random characters. CONSOLE_SESSION_SECRET: the
# session-cookie HMAC key, e.g. `openssl rand -hex 32`.
CONSOLE_PASSWORD=
CONSOLE_SESSION_SECRET=

# Origin check — comma-separated extra Origins to allow on mutation routes.
# Same-origin requests (Origin exactly matches this console's origin) are
# allowed; a mutation with no Origin header is always rejected (403).
# Add an entry when the console runs behind a reverse proxy or on a
# different external origin than the internal Host header, e.g.:
#   TRUSTED_ORIGINS=https://console.example.com,https://console-staging.example.com
TRUSTED_ORIGINS=
